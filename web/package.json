{
  "name": "conf-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "El front de conf: vista de audiencia, overlay para OBS/vMix, consola de emisión y panel de producción. Astro estático con islas React sobre @ahroi/foundation (familia pliego).",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && node scripts/guarda-artefacto.mjs",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@ahroi/foundation": "https://codeload.github.com/MEMEMEMEMEMEMEDev/aegis-canvas/tar.gz/refs/tags/v0.13.1",
    "@astrojs/react": "6.0.2",
    "astro": "7.2.2",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "1.90.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
