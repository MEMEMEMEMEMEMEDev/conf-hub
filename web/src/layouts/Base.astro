---
// El marco de todas las páginas: la isla PLIEGO entera (mini-contrato
// --pliego-* en .pliego-scope) y nada más. Cada página decide su lámina.
interface Props {
  titulo: string;
  descripcion?: string;
  transparente?: boolean; // el overlay de OBS: sin fondo
}
const { titulo, descripcion = "Subtítulos y traducción en vivo para conferencias, open source, sobre aegis.", transparente = false } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%23fd3564'/%3E%3Crect x='3' y='9' width='10' height='2' fill='%23fff'/%3E%3Crect x='3' y='12' width='7' height='2' fill='%23fff'/%3E%3C/svg%3E" />
    <title>{titulo}</title>
  </head>
  <body class:list={["pliego-scope", { transparente }]}>
    <main><slot /></main>
  </body>
</html>
<style is:global>
  html, body { margin: 0; min-height: 100%; }
  body { min-height: 100vh; }
  body.transparente, html:has(body.transparente) { background: transparent !important; }
  *, *::before, *::after { box-sizing: border-box; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  a { color: var(--pliego-rosa-tinta); }
  .lamina { max-width: 72rem; margin: 0 auto; padding: clamp(1rem, 4vw, 3rem); display: grid; gap: 2rem;
    grid-template-columns: minmax(0, 1fr); }
  /* Un ítem de grid no se achica por debajo de su contenido (min-width:auto):
     una tabla ancha o un título largo ensanchaban la página entera en un
     teléfono. Medido con Playwright a 390 px. */
  .lamina > *, .lamina section > * { min-width: 0; }
  /* break-word y NO anywhere: anywhere baja el ancho mínimo a una letra y,
     dentro de un flex, el título del panel salía en vertical. */
  .pliego-titulo__palabra { overflow-wrap: break-word; }
  .fila { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .micro { font: 600 .78rem/1.4 var(--pliego-font); letter-spacing: .14em; text-transform: uppercase; }
  .prosa { font: 400 1.05rem/1.6 var(--pliego-font); max-width: 62ch; margin: 0; }
  .prosa + .prosa { margin-top: .8rem; }
</style>
